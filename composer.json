{
    "name": "libriciel/comelus-api-wrapper",
    "version": "3.0.0",
    "authors": [
        {
            "name": "Théo GUILLON",
            "email": "theo.guillon@libriciel.coop",
            "homepage": "https://www.libriciel.fr/comelus/",
            "role": "Project Manager"
        }
    ],
    "require": {
        "php": ">=8.3",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "php-http/multipart-stream-builder": "^1.1",
        "ext-json": "*",
        "nyholm/psr7": "^1.8",
        "symfony/http-foundation": "^7.3",
        "symfony/mime": "^7.3"
    },
    "autoload": {
        "psr-4": {
            "Libriciel\\ComelusApiWrapper\\": "src/",
            "Libriciel\\ComelusApiWrapper\\Test\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "symfony/uid": "^7.3"
    }
}
