{
    "name": "libriciel/comelus-api-wrapper",
    "description": "Wrapper PHP de l'API Comélus : Vérification de la connexion, listes de diffusion, création et envoi des dossiers",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Théo GUILLON",
            "email": "theo.guillon@libriciel.coop",
            "homepage": "https://www.libriciel.fr/comelus/",
            "role": "Project Manager"
        },
        {
            "name": "Antonin RABATEL",
            "email": "arabatel@libriciel.coop",
            "homepage": "https://www.libriciel.fr/comelus/",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.3",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "php-http/multipart-stream-builder": "^1.4",
        "ext-json": "*",
        "nyholm/psr7": "^1.8",
        "symfony/http-foundation": "^7.3",
        "symfony/mime": "^7.3"
    },
    "autoload": {
        "psr-4": {
            "Libriciel\\ComelusApiWrapper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Libriciel\\ComelusApiWrapper\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "symfony/uid": "^7.3"
    }
}
