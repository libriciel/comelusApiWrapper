{
    "name": "libriciel/comelus-api-wrapper",
    "version": "2.0.0",
    "authors": [
        {
            "name": "rdubourget",
            "email": "remi.dubourget@libriciel.coop"
        }
    ],
    "require": {
        "php": ">=8.1",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "php-http/multipart-stream-builder": "^1.3",
        "ext-json": "*",
        "nyholm/psr7": "^1.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.4"
    },
    "autoload": {
        "psr-4": {
            "Libriciel\\ComelusApiWrapper\\": "src/",
            "Libriciel\\ComelusApiWrapper\\Test\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
